# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ========================
# Node.js / React
# ========================
node_modules/
frontend/dist/
frontend/build/
*.tsbuildinfo

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
!.env.example

# ========================
# IDE / Editors
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Testing & Coverage
# ========================
.coverage
htmlcov/
.pytest_cache/
coverage/

# ========================
# Alembic
# ========================
alembic/versions/*.pyc

# ========================
# Logs
# ========================
*.log
# log.txt is the §7 audit log per rules.md — keep tracked
!log.txt

# ========================
# Ad-hoc / orphan test scripts at repo root
# (Real tests live in backend/tests/ and frontend/src/**)
# ========================
/test_*.py

# ========================
# Claude Code / agent local config
# (per-developer permission allowlists; don't pollute the team repo)
# ========================
.claude/

# ========================
# Agent evals — generated artifacts
# (Calibration reports + judge cache are LLM-output snapshots, not
# inputs. They change every run; committing them would create noisy
# diffs and leak Gemini outputs into git history.)
# ========================
backend/evals/reports/
backend/evals/.judge_cache/
